{
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://skillswap-backend-d0gr.onrender.com/api/:path*"
        },
        {
            "source": "/socket.io/:path*",
            "destination": "https://skillswap-backend-d0gr.onrender.com/socket.io/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/index.html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                }
            ]
        }
    ]
}